  "title": "S4HANABillingDocumentSchema",
  "type": "object",
  "properties": {
    "BillingDocumentType": { "type": "string" },
    "SalesOrganization": { "type": "string" },
    "TotalNetAmount": { "type": "number" },
    "to_Item": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "BillingDocumentItem": { "type": "string" },
          "Product": { "type": "string" },
          "BillingQuantity": { "type": "string" }
